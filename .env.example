# Discord Bot Configuration
# Paste your Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Command Prefix (e.g. !play, !skip)
BOT_PREFIX=!

# Web Dashboard Server Port and Host
HOST=0.0.0.0
PORT=8000

# Default Guild / Voice Channel (Optional)
AUTO_CONNECT_VOICE_CHANNEL_ID=
